// Prisma schema for the back-office user management API.
// The connection URL is provided by prisma.config.ts (Prisma 7+).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  active
  inactive
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  firstName    String     @map("first_name") @db.VarChar(100)
  lastName     String     @map("last_name") @db.VarChar(100)
  /// Login identifier, always stored lower-cased.
  email        String     @unique @db.VarChar(254)
  passwordHash String     @map("password_hash")
  status       UserStatus @default(active)
  loginsCount  Int        @default(0) @map("logins_count")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]

  // Supports the stable "newest first" ordering used by the paginated list.
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@map("users")
}

model Session {
  /// Random UUIDv4 generated by the application; doubles as the bearer token.
  id           String    @id @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  terminatedAt DateTime? @map("terminated_at") @db.Timestamptz(3)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

# Local development settings for the API (copy to apps/api/.env).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# Matches the `db` service in docker-compose.yml (exposed on localhost:5432).
DATABASE_URL=postgresql://ums:ums@localhost:5432/ums?schema=public

# Sessions expire this many hours after creation.
SESSION_TTL_HOURS=24

# Comma-separated list of allowed browser origins (only needed when the web app
# is served from a different origin than the API).
CORS_ORIGIN=http://localhost:5173

# Requests per minute per IP: global and for sign-in/sign-up.
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

TRUST_PROXY=false
SWAGGER_ENABLED=true

# Credentials used by `npm run db:seed` for the initial admin account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!

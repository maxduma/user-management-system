{
  "name": "user-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Back-office application for registering and managing users (Fastify + Prisma API, React + MUI client).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm run dev -w @ums/api\" \"npm run dev -w @ums/web\"",
    "build": "npm run build -w @ums/api -w @ums/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:integration": "npm run test:integration -w @ums/api",
    "e2e": "npm run e2e -w @ums/e2e",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "e2e:docker": "AUTH_RATE_LIMIT_MAX=1000 docker compose up -d --build --wait && npm run e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  }
}

# Optional overrides for docker-compose.yml (copy to .env). All values have defaults.

# Host ports
WEB_PORT=8080
POSTGRES_PORT=5432

# Database credentials
POSTGRES_USER=ums
POSTGRES_PASSWORD=ums
POSTGRES_DB=ums

# API
LOG_LEVEL=info
SESSION_TTL_HOURS=24
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SWAGGER_ENABLED=true

# Demo data: an admin account plus 14 users (some inactive) to showcase pagination.
SEED_DEMO_DATA=true
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
